---
import { getCollection, render } from 'astro:content';
import { constellations } from '../data/constellations';
import '../styles/global.css';
import '../styles/art-direction.css';

const slugify = (name: string) => name.toLowerCase().replaceAll(' ', '-');
const articleConstellation = (entry: { id: string; data: { constellation?: string } }) => {
  const folder = entry.id.split('/')[0];
  return constellations.find((constellation) => slugify(constellation.name) === folder)?.name
    ?? entry.data.constellation;
};
const allArticles = (await getCollection('articles')).filter((entry) => !entry.data.draft);
const compareArticles = (a: typeof allArticles[number], b: typeof allArticles[number]) => {
  const aOrder = a.data.order;
  const bOrder = b.data.order;
  if (aOrder !== undefined && bOrder === undefined) return -1;
  if (aOrder === undefined && bOrder !== undefined) return 1;
  if (aOrder !== undefined && bOrder !== undefined && aOrder !== bOrder) return aOrder - bOrder;
  return a.data.title.localeCompare(b.data.title, 'en', { numeric: true, sensitivity: 'base' })
    || a.id.localeCompare(b.id, 'en', { numeric: true, sensitivity: 'base' });
};
const articlesByConstellation = Object.fromEntries(constellations.map((constellation) => [
  constellation.name,
  allArticles.filter((article) => articleConstellation(article) === constellation.name)
    .sort(compareArticles),
]));
const renderedArticles = await Promise.all(allArticles.map(async (entry) => ({
  entry,
  Content: (await render(entry)).Content,
  idea: entry.data.idea,
})));
const carouselConstellations = [constellations[constellations.length - 1], ...constellations, constellations[0]];
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-PNSLRJRT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11120d" />
    <meta name="description" content="Astriferous" />
    <title>Astriferous</title>
  </head>
  <body>
    <a class="wordmark" href="#observatory" aria-label="Astriferous home">ASTRIFEROUS</a>
    <main>
      <section class="observatory" id="observatory" aria-label="The observatory">
        <div class="dome-ribs" aria-hidden="true"></div>
        <div class="nebula-haze" aria-hidden="true"></div>
        <div class="star-field" aria-hidden="true"></div>
        <div class="broken-wall wall-left" aria-hidden="true"></div>
        <div class="broken-wall wall-right" aria-hidden="true"></div>
        <div class="tile-floor" aria-hidden="true"></div>
        <div class="stone-light-sweep" aria-hidden="true"></div>
        <div class="carousel-controls" aria-label="Constellation carousel">
          <button class="carousel-arrow" data-direction="-1" aria-label="Previous constellation">←</button>
          <span class="carousel-mark" aria-hidden="true">✦</span>
          <button class="carousel-arrow" data-direction="1" aria-label="Next constellation">→</button>
        </div>
        <div class="carousel-viewport" aria-label="Constellations">
          <div class="carousel-track">
            {carouselConstellations.map((constellation, displayIndex) => {
              const index = displayIndex === 0 ? constellations.length - 1 : displayIndex === carouselConstellations.length - 1 ? 0 : displayIndex - 1;
              const isClone = displayIndex === 0 || displayIndex === carouselConstellations.length - 1;
              const slug = slugify(constellation.name);
              const points = constellation.stars.map(([x, y]) => `${x},${y}`).join(' ');
              return <article class:list={['constellation-card', displayIndex === 1 && 'is-focused']} data-slide data-real-index={index} data-clone={isClone ? 'true' : undefined} id={`slide-${slug}-${displayIndex}`} tabindex="0" aria-label={constellation.name}>
                <div class="celestial-drawing">
                  <div class="constellation-target" tabindex="0" role="img" aria-label={`Star pattern of ${constellation.name}`} data-figure-trigger>
                    <svg class="star-map" viewBox="0 0 100 85" aria-hidden="true"><polyline points={points} />{constellation.stars.map(([x, y]) => <circle cx={x} cy={y} r="2.15" />)}</svg>
                    <svg class="figure-art" viewBox="0 0 100 100" aria-hidden="true">{constellation.figure.map((path) => <path d={path} pathLength="1" />)}</svg>
                  </div>
                </div>
                <div class="constellation-copy"><h2>{constellation.name}</h2><p>{constellation.epithet}</p></div>
                <button class="enter-portal" data-open={slug} aria-haspopup="dialog">View</button>
              </article>;
            })}
          </div>
        </div>
        <div class="carousel-caption" aria-live="polite" aria-atomic="true">
          <h1 data-caption-name>{constellations[0].name}</h1>
          <p data-caption-epithet>{constellations[0].epithet}</p>
          <button class="caption-enter" data-caption-open aria-haspopup="dialog">View</button>
        </div>
        <div class="horizon" aria-hidden="true"></div>
        <a class="instagram-contact" href="https://www.instagram.com/oblisake_/" target="_blank" rel="noopener noreferrer" aria-label="Instagram, oblisake_">Instagram <span>@oblisake_</span></a>
      </section>

      <dialog class="archive-overlay" id="archive" aria-label="Constellation archive">
        <section class="archive-window">
          <button class="close-archive" aria-label="Close">×</button>
          <article class="reader-pane" aria-label="Article reader">
            <div class="reader-pane-frame" aria-hidden="true">
              <img class="reader-pane-boundary" src="/images/reader-window/outer-frame.png" alt="" />
              <img class="reader-frame-corner reader-frame-corner--top-left" src="/images/reader-window/corner-boundary.png" alt="" />
              <img class="reader-frame-corner reader-frame-corner--top-right" src="/images/reader-window/corner-boundary.png" alt="" />
              <img class="reader-frame-corner reader-frame-corner--bottom-left" src="/images/reader-window/corner-boundary.png" alt="" />
              <img class="reader-frame-corner reader-frame-corner--bottom-right" src="/images/reader-window/corner-boundary.png" alt="" />
            </div>
            <header class="reader-heading">
              <p class="reader-idea" data-reader-idea></p>
              <div class="article-picker-wrap">
                <button class="reader-title-picker" type="button" data-article-picker-trigger aria-controls="article-picker" aria-expanded="false">
                  <span class="reader-title" data-reader-title>Contents</span>
                  <span class="picker-mark" aria-hidden="true">⌄</span>
                </button>
                <div class="article-picker" id="article-picker" aria-label="Articles" hidden>
                  {constellations.map((constellation) => {
                    const slug = slugify(constellation.name);
                    const articles = articlesByConstellation[constellation.name];
                    return <div class="contents-list" data-contents={slug} hidden>
                      {articles.length ? <ol>{articles.map((article) => <li><button data-article={article.id} data-idea={article.data.idea ?? ''} aria-current="false">{article.data.title}<span>↗</span></button></li>)}</ol> : <p class="unwritten">Unwritten.</p>}
                    </div>;
                  })}
                </div>
              </div>
              <img class="reader-short-boundary" src="/images/reader-window/short-boundary.png" alt="" />
            </header>
            <div class="reader-scroll">
              <div class="reader-body" data-reader-body></div>
            </div>
            <span class="reader-ornament" aria-hidden="true">✦</span>
          </article>
          <aside class="constellation-artwork" aria-label="Selected constellation">
            <span class="constellation-number"><span data-active-number>01</span><span aria-hidden="true"> / 12</span></span>
            <div class="archive-emblem" data-active-figure aria-hidden="true"></div>
            <div class="constellation-controls" aria-label="Change constellation">
              <button class="constellation-step constellation-step--previous" type="button" data-constellation-step="-1" aria-label="Previous constellation"><img src="/images/reader-window/constellation-arrow.png" alt="" /></button>
              <h2 data-active-name></h2>
              <button class="constellation-step constellation-step--next" type="button" data-constellation-step="1" aria-label="Next constellation"><img src="/images/reader-window/constellation-arrow.png" alt="" /></button>
            </div>
          </aside>
        </section>
      </dialog>

      {renderedArticles.map(({ entry, Content, idea }) => <template id={`article-${entry.id}`} data-idea={idea ?? ''}><Content /></template>)}
    </main>
    <script>
      import { constellations } from '../data/constellations';

      const slugify = (name: string) => name.toLowerCase().replaceAll(' ', '-');
      const viewport = document.querySelector<HTMLElement>('.carousel-viewport');
      const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
      const captionName = document.querySelector<HTMLElement>('[data-caption-name]');
      const captionEpithet = document.querySelector<HTMLElement>('[data-caption-epithet]');
      const captionOpen = document.querySelector<HTMLButtonElement>('[data-caption-open]');
      const nebula = document.querySelector<HTMLElement>('.nebula-haze');
      const stoneLightSweep = document.querySelector<HTMLElement>('.stone-light-sweep');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let motionModule: Promise<typeof import('motion')> | undefined;
      const loadMotion = () => motionModule ??= import('motion');
      let activeScrollAnimation: { stop: () => void } | undefined;
      let scrollRequestId = 0;
      let nebulaAnimation: { stop: () => void } | undefined;
      let stoneSweepAnimation: { stop: () => void } | undefined;
      let autoplayTimer: number | undefined;
      let scheduleAutoplay: (delay: number) => void = () => {};
      let wheelFrame = 0;
      let wheelDestination = 0;

      const centeredScroll = (slide: HTMLElement) => {
        if (!viewport) return 0;
        return slide.offsetLeft + slide.offsetWidth / 2 - viewport.clientWidth / 2;
      };
      const centerOn = async (slide: HTMLElement, duration = 1.5) => {
        if (!viewport) return;
        const requestId = ++scrollRequestId;
        if (wheelFrame) { cancelAnimationFrame(wheelFrame); wheelFrame = 0; }
        activeScrollAnimation?.stop();
        activeScrollAnimation = undefined;
        const destination = centeredScroll(slide);
        viewport.classList.add('is-animating');
        if (reducedMotion) {
          viewport.scrollLeft = destination;
          viewport.classList.remove('is-animating');
          markCenter();
          return;
        }
        try {
          const { animate } = await loadMotion();
          if (requestId !== scrollRequestId) return;
          if (!reducedMotion && !nebulaAnimation && nebula) {
            nebulaAnimation = animate(nebula, {
              x: ['-1.5%', '1.25%', '-1.5%'],
              y: ['0%', '1.1%', '0%'],
              scale: [1, 1.035, 1],
              opacity: [0.58, 0.84, 0.58],
            }, { duration: 116, ease: 'easeInOut', repeat: Infinity });
          }
          activeScrollAnimation = animate(viewport.scrollLeft, destination, {
            duration,
            ease: [0.16, 1, 0.3, 1],
            onUpdate: (latest) => { viewport.scrollLeft = latest; },
            onComplete: () => {
              if (requestId !== scrollRequestId) return;
              activeScrollAnimation = undefined;
              if (slide.dataset.clone === 'true') {
                const realIndex = Number(slide.dataset.realIndex);
                const realSlide = slides.find((item) => item.dataset.clone !== 'true' && Number(item.dataset.realIndex) === realIndex);
                if (realSlide) viewport.scrollLeft = centeredScroll(realSlide);
              }
              viewport.classList.remove('is-animating');
              markCenter();
            },
          });
        } catch {
          if (requestId !== scrollRequestId) return;
          viewport.classList.remove('is-animating');
          viewport.scrollTo({ left: destination, behavior: 'smooth' });
        }
      };
      let focusedSlide: HTMLElement | undefined;
      const markCenter = () => {
        if (!viewport) return;
        const middle = viewport.scrollLeft + viewport.clientWidth / 2;
        let closest: HTMLElement | undefined;
        let distance = Infinity;
        slides.forEach((slide) => { const next = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - middle); if (next < distance) { distance = next; closest = slide; } });
        if (closest && focusedSlide !== closest) {
          focusedSlide?.classList.remove('is-focused');
          closest.classList.add('is-focused');
          focusedSlide = closest;
          const realIndex = Number(closest.dataset.realIndex);
          const name = closest.getAttribute('aria-label') ?? '';
          captionName!.textContent = name;
          captionEpithet!.textContent = constellations[realIndex]?.epithet ?? '';
          captionOpen!.dataset.open = slugify(name);
        }
      };
      const stopAutoplay = () => {
        if (autoplayTimer) window.clearTimeout(autoplayTimer);
        autoplayTimer = window.setTimeout(() => { autoplayTimer = undefined; scheduleAutoplay(4000); }, 7000);
      };
      const pauseCarousel = () => {
        if (autoplayTimer) window.clearTimeout(autoplayTimer);
        autoplayTimer = undefined;
        scrollRequestId++;
        activeScrollAnimation?.stop();
        activeScrollAnimation = undefined;
        if (wheelFrame) { cancelAnimationFrame(wheelFrame); wheelFrame = 0; }
        viewport?.classList.remove('is-animating');
        nebulaAnimation?.stop();
        nebulaAnimation = undefined;
      };
      const resumeCarousel = () => {
        if (reducedMotion || !viewport || slides.length < 2) return;
        markCenter();
        if (focusedSlide && Math.abs(centeredScroll(focusedSlide) - viewport.scrollLeft) > 1) {
          void centerOn(focusedSlide, 0.9);
          scheduleAutoplay(5000);
        } else scheduleAutoplay(3500);
      };
      let focusFrame = 0;
      viewport?.addEventListener('scroll', () => {
        if (viewport?.classList.contains('is-animating')) return;
        if (focusFrame) return;
        focusFrame = requestAnimationFrame(() => {
          focusFrame = 0;
          if (!viewport?.classList.contains('is-animating')) markCenter();
        });
      }, { passive: true });
      viewport?.addEventListener('wheel', (event) => {
        if (!viewport || Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
        event.preventDefault();
        stopAutoplay();
        scrollRequestId++;
        activeScrollAnimation?.stop();
        activeScrollAnimation = undefined;
        viewport.classList.add('is-animating');
        wheelDestination = Math.max(0, Math.min(viewport.scrollWidth - viewport.clientWidth, (wheelFrame ? wheelDestination : viewport.scrollLeft) + event.deltaY));
        if (wheelFrame) return;
        const glide = () => {
          if (!viewport) return;
          const difference = wheelDestination - viewport.scrollLeft;
          if (Math.abs(difference) < 0.7) {
            viewport.scrollLeft = wheelDestination;
            viewport.classList.remove('is-animating');
            wheelFrame = 0;
            markCenter();
            return;
          }
          viewport.scrollLeft += difference * 0.14;
          wheelFrame = requestAnimationFrame(glide);
        };
        wheelFrame = requestAnimationFrame(glide);
      }, { passive: false });
      requestAnimationFrame(() => { const start = slides.find((slide) => slide.dataset.clone !== 'true' && Number(slide.dataset.realIndex) === 0); if (viewport && start) viewport.scrollLeft = centeredScroll(start); markCenter(); });
      markCenter();

      if (viewport && slides.length > 1 && !reducedMotion) {
        scheduleAutoplay = (delay: number) => {
          if (autoplayTimer) window.clearTimeout(autoplayTimer);
          autoplayTimer = window.setTimeout(() => {
          const current = slides.find((slide) => slide.classList.contains('is-focused'));
          const realIndex = Number(current?.dataset.realIndex ?? 0);
          const nextReal = (realIndex + 1) % constellations.length;
          const next = realIndex === constellations.length - 1
            ? slides[slides.length - 1]
            : slides.find((slide) => slide.dataset.clone !== 'true' && Number(slide.dataset.realIndex) === nextReal);
          if (next) void centerOn(next, reducedMotion ? 0 : 8);
          scheduleAutoplay(10500);
          }, delay);
        };
        scheduleAutoplay(3500);
        viewport.addEventListener('pointerdown', () => {
          stopAutoplay();
          scrollRequestId++;
          activeScrollAnimation?.stop();
          activeScrollAnimation = undefined;
          if (wheelFrame) { cancelAnimationFrame(wheelFrame); wheelFrame = 0; }
          viewport.classList.remove('is-animating');
        });
        viewport.addEventListener('focusin', stopAutoplay);
      }
      document.querySelectorAll<HTMLButtonElement>('.carousel-arrow').forEach((button) => button.addEventListener('click', () => {
        stopAutoplay();
        const current = slides.find((slide) => slide.classList.contains('is-focused'));
        if (!current) return;
        const direction = Number(button.dataset.direction);
        const realIndex = Number(current.dataset.realIndex);
        let targetIndex = realIndex + direction;
        if (targetIndex < 0) targetIndex = constellations.length - 1;
        if (targetIndex >= constellations.length) targetIndex = 0;
        const target = slides.find((slide) => Number(slide.dataset.realIndex) === targetIndex &&
          ((direction < 0 && realIndex === 0) ? slide.dataset.clone === 'true' && slides.indexOf(slide) === 0 :
           (direction > 0 && realIndex === constellations.length - 1) ? slide.dataset.clone === 'true' && slides.indexOf(slide) === slides.length - 1 :
           slide.dataset.clone !== 'true'));
        if (target) void centerOn(target);
      }));
      captionOpen?.addEventListener('click', () => {
        const slug = captionOpen.dataset.open ?? '';
        openArchive(slug);
      });

      const archive = document.querySelector<HTMLDialogElement>('#archive');
      const activeName = archive?.querySelector<HTMLElement>('[data-active-name]');
      const activeNumber = archive?.querySelector<HTMLElement>('[data-active-number]');
      const activeFigure = archive?.querySelector<HTMLElement>('[data-active-figure]');
      const readerTitle = archive?.querySelector<HTMLElement>('[data-reader-title]');
      const articlePicker = archive?.querySelector<HTMLElement>('#article-picker');
      const articlePickerTrigger = archive?.querySelector<HTMLButtonElement>('[data-article-picker-trigger]');
      const readerIdea = archive?.querySelector<HTMLElement>('[data-reader-idea]');
      const readerBody = archive?.querySelector<HTMLElement>('[data-reader-body]');
      let readerArrival: Animation | undefined;
      const svgNamespace = 'http://www.w3.org/2000/svg';
      const selectConstellation = (slug: string) => {
        const constellation = constellations.find((item) => slugify(item.name) === slug);
        if (!constellation || !archive) return;
        activeName!.textContent = constellation.name;
        activeNumber!.textContent = String(constellations.indexOf(constellation) + 1).padStart(2, '0');
        archive.dataset.constellation = slug;
        const starXs = constellation.stars.map(([x]) => x);
        const starYs = constellation.stars.map(([, y]) => y);
        const minX = Math.min(...starXs);
        const minY = Math.min(...starYs);
        const padding = 6;
        const viewBoxWidth = Math.max(...starXs) - minX + padding * 2;
        const viewBoxHeight = Math.max(...starYs) - minY + padding * 2;
        const normalizedStars = constellation.stars.map(([x, y]) => [
          ((x - minX + padding) / viewBoxWidth) * 100,
          ((y - minY + padding) / viewBoxHeight) * 100,
        ]);
        const starPoints = normalizedStars.map(([x, y]) => `${x},${y}`).join(' ');
        const starMap = document.createElementNS(svgNamespace, 'svg');
        starMap.classList.add('archive-star-map');
        starMap.setAttribute('viewBox', '0 0 100 100');
        starMap.setAttribute('aria-hidden', 'true');
        starMap.setAttribute('preserveAspectRatio', 'none');
        const starLine = document.createElementNS(svgNamespace, 'polyline');
        starLine.setAttribute('points', starPoints);
        starMap.append(starLine);
        const starPointsLayer = normalizedStars.map(([x, y]) => {
          const star = document.createElement('span');
          star.classList.add('archive-star-point');
          star.style.setProperty('--star-x', `${x}%`);
          star.style.setProperty('--star-y', `${y}%`);
          return star;
        });
        activeFigure!.replaceChildren(starMap, ...starPointsLayer);
        archive.querySelectorAll<HTMLElement>('[data-contents]').forEach((contents) => { contents.hidden = contents.dataset.contents !== slug; });
        archive.querySelectorAll<HTMLButtonElement>('[data-article]').forEach((button) => { button.setAttribute('aria-current', 'false'); button.classList.remove('selected'); });
        readerTitle!.textContent = 'Contents';
        readerIdea!.textContent = '';
        readerArrival?.cancel();
        readerArrival = undefined;
        readerBody!.replaceChildren();
        const currentContents = archive.querySelector<HTMLElement>(`[data-contents="${CSS.escape(slug)}"]`);
        const hasArticles = Boolean(currentContents?.querySelector('[data-article]'));
        articlePickerTrigger!.disabled = !hasArticles;
        articlePicker!.hidden = true;
        articlePickerTrigger!.setAttribute('aria-expanded', 'false');
        if (!hasArticles) readerBody!.textContent = 'Unwritten.';
      };
      const openArchive = (slug: string) => {
        pauseCarousel();
        selectConstellation(slug);
        archive?.showModal();
        archive?.classList.add('opening');
        if (!reducedMotion && stoneLightSweep) {
          void (async () => {
            try {
              const { animate } = await loadMotion();
              stoneSweepAnimation?.stop();
              stoneSweepAnimation = animate(stoneLightSweep, {
                x: ['-25vw', '120vw'],
                opacity: [0, 0.32, 0],
              }, { duration: 3.4, ease: 'easeInOut' });
            } catch {
              stoneLightSweep.style.opacity = '0';
            }
          })();
        }
      };

      slides.forEach((slide) => {
        const target = slide.querySelector<HTMLElement>('[data-figure-trigger]');
        const trace = () => {
          if (viewport?.classList.contains('is-animating')) return;
          slide.classList.add('tracing');
          if (!reducedMotion) slide.querySelectorAll<SVGPathElement>('.figure-art path').forEach((path, pathIndex) => {
            path.style.transitionDelay = `${pathIndex * 85}ms`;
            path.classList.add('drawn');
          });
        };
        const clear = () => {
          slide.classList.remove('tracing');
          slide.querySelectorAll<SVGPathElement>('.figure-art path').forEach((path) => { path.classList.remove('drawn'); path.style.transitionDelay = ''; });
        };
        target?.addEventListener('pointerenter', trace);
        target?.addEventListener('pointerleave', clear);
        target?.addEventListener('focus', trace);
        target?.addEventListener('blur', clear);
        slide.querySelector<HTMLButtonElement>('[data-open]')?.addEventListener('click', () => {
          openArchive(slugify(slide.getAttribute('aria-label') ?? ''));
        });
      });
      archive?.querySelectorAll<HTMLButtonElement>('[data-constellation-step]').forEach((button) => button.addEventListener('click', () => {
        const currentIndex = constellations.findIndex((item) => slugify(item.name) === archive.dataset.constellation);
        const direction = Number(button.dataset.constellationStep);
        const nextIndex = (currentIndex + direction + constellations.length) % constellations.length;
        selectConstellation(slugify(constellations[nextIndex].name));
      }));
      articlePickerTrigger?.addEventListener('click', () => {
        const willOpen = articlePicker!.hidden;
        articlePicker!.hidden = !willOpen;
        articlePickerTrigger.setAttribute('aria-expanded', String(willOpen));
      });
      articlePickerTrigger?.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowDown') return;
        event.preventDefault();
        articlePicker!.hidden = false;
        articlePickerTrigger.setAttribute('aria-expanded', 'true');
        archive?.querySelector<HTMLElement>(`[data-contents="${CSS.escape(archive.dataset.constellation ?? '')}"] [data-article]`)?.focus();
      });
      archive?.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || articlePicker!.hidden) return;
        event.preventDefault();
        event.stopPropagation();
        articlePicker!.hidden = true;
        articlePickerTrigger!.setAttribute('aria-expanded', 'false');
        articlePickerTrigger!.focus();
      }, true);
      archive?.addEventListener('click', (event) => {
        if (!(event.target instanceof Element) || event.target.closest('.article-picker-wrap')) return;
        articlePicker!.hidden = true;
        articlePickerTrigger!.setAttribute('aria-expanded', 'false');
      });
      archive?.querySelectorAll<HTMLButtonElement>('[data-article]').forEach((button) => button.addEventListener('click', () => {
        const template = document.querySelector<HTMLTemplateElement>(`#article-${CSS.escape(button.dataset.article ?? '')}`);
        if (!template || !readerBody) return;
        readerTitle!.textContent = button.textContent?.replace('↗', '').trim() ?? '';
        readerIdea!.textContent = button.dataset.idea ?? '';
        readerBody.replaceChildren(template.content.cloneNode(true));
        archive?.querySelectorAll<HTMLButtonElement>('[data-article]').forEach((item) => { const selected = item === button; item.classList.toggle('selected', selected); item.setAttribute('aria-current', String(selected)); });
        articlePicker!.hidden = true;
        articlePickerTrigger!.setAttribute('aria-expanded', 'false');
        if (!reducedMotion) {
          readerArrival?.cancel();
          readerArrival = readerBody.animate(
            [{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'translateY(0)' }],
            { duration: 440, easing: 'cubic-bezier(.16,1,.3,1)' },
          );
        }
      }));
      archive?.addEventListener('close', () => {
        archive.classList.remove('opening');
        stoneSweepAnimation?.stop();
        stoneSweepAnimation = undefined;
        if (stoneLightSweep) stoneLightSweep.style.opacity = '0';
        resumeCarousel();
      });
      archive?.querySelector('.close-archive')?.addEventListener('click', () => { archive.classList.remove('opening'); archive.close(); });
      archive?.addEventListener('click', (event) => { if (event.target === archive) archive.close(); });
    </script>
  </body>
</html>
